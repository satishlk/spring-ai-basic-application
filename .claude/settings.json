{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(open *)",
      "Bash(curl *)",
      "Bash(git *)",
      "Bash(mvn)",
      "Bash(mvn *)",
      "Bash(source *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(python3 *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)",
      "Bash(export *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(git push --force *main*)",
      "Bash(git push --force *master*)",
      "Bash(git push -f *main*)",
      "Bash(git push -f *master*)",
      "Bash(git reset --hard *origin/main*)",
      "Bash(git reset --hard *origin/master*)"
    ]
  }
}
