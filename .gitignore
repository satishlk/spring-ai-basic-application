# =============================================================================
# .gitignore — Checkout Service (Java / Maven / Spring Boot)
# -----------------------------------------------------------------------------
# Convention: section-by-section, with comments. If you add a new tool, add a
# new section — don't sprinkle entries across the file.
# =============================================================================


# -----------------------------------------------------------------------------
# Maven build output
# -----------------------------------------------------------------------------
target/
build/
out/
dependency-reduced-pom.xml
release.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next


# -----------------------------------------------------------------------------
# Gradle (in case any submodule uses Gradle later)
# -----------------------------------------------------------------------------
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties


# -----------------------------------------------------------------------------
# Compiled artifacts — never commit binaries
# -----------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
hs_err_pid*
replay_pid*

# Exception: keep Maven/Gradle wrapper JARs (they ARE meant to be committed)
!**/maven-wrapper.jar
!**/gradle-wrapper.jar


# -----------------------------------------------------------------------------
# Spring Boot
# -----------------------------------------------------------------------------
*.original
BOOT-INF/
spring-shell.log
application-local.yml
application-local.yaml
application-local.properties
application-secrets.yml


# -----------------------------------------------------------------------------
# IntelliJ IDEA
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
atlassian-ide-plugin.xml


# -----------------------------------------------------------------------------
# Eclipse / STS
# -----------------------------------------------------------------------------
.project
.classpath
.settings/
.metadata/
.factorypath
.springBeans
.sts4-cache/
.apt_generated/
.apt_generated_test/


# -----------------------------------------------------------------------------
# VS Code (commit shared settings; ignore per-user)
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
*.code-workspace


# -----------------------------------------------------------------------------
# NetBeans
# -----------------------------------------------------------------------------
nb-configuration.xml
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/


# -----------------------------------------------------------------------------
# Operating system noise
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
*.log.*
logs/
log/
spring.log


# -----------------------------------------------------------------------------
# Local databases (H2 file mode, SQLite)
# -----------------------------------------------------------------------------
*.db
*.mv.db
*.trace.db
*.h2.db
*.sqlite
*.sqlite3


# -----------------------------------------------------------------------------
# Test reports / coverage
# -----------------------------------------------------------------------------
**/surefire-reports/
**/failsafe-reports/
**/site/
*.coverage.xml
coverage/
jacoco.exec
jacoco-it.exec
.scannerwork/        # SonarQube


# -----------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
secrets/
credentials.json

# SSH keys — block by common filename patterns (a real key was once leaked here)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
/github
/github.pub
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub


# -----------------------------------------------------------------------------
# Editor / temp / backup files
# -----------------------------------------------------------------------------
*~
*.swp
*.swo
*.bak
*.tmp
*.orig
.#*
\#*\#


# -----------------------------------------------------------------------------
# Python (in case you add helper scripts)
# -----------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/


# -----------------------------------------------------------------------------
# Node / frontend tooling (in case the checkout page grows into an SPA)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/


# -----------------------------------------------------------------------------
# Docker & infra-local state
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.backup
.terraformrc
terraform.rc

# Sub-agent isolated worktree cache (transient, never commit)
.claude/worktrees/
